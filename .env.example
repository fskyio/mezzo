# Listening port
MEZZO_PORT=8006

# Link to any patches that were applied (only if running modified source code)
# MEZZO_PATCHES_URL=

# Cache settings
MEZZO_CACHE_DISABLED=false
MEZZO_CACHE_GIF_TTL=1h
MEZZO_CACHE_GIF_MAX=1000
MEZZO_CACHE_SEARCH_TTL=10m
MEZZO_CACHE_SEARCH_MAX=500
MEZZO_CACHE_PROFILE_TTL=30m
MEZZO_CACHE_PROFILE_MAX=200

# Media cache on disk (off unless a directory is set)
MEZZO_CACHE_MEDIA_DIR=
MEZZO_CACHE_MEDIA_MAX_MB=512
MEZZO_CACHE_MEDIA_MAX_FILE_MB=16
MEZZO_CACHE_MEDIA_TTL=168h
MEZZO_CACHE_AVATAR_TTL=24h
