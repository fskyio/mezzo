#!/sbin/openrc-run

name=mezzo
command="/usr/local/bin/mezzo"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
command_user="mezzo:mezzo"

export MEZZO_PORT="${MEZZO_PORT:-8006}"
export MEZZO_PATCHES_URL="${MEZZO_PATCHES_URL:-}"
export MEZZO_CACHE_DISABLED="${MEZZO_CACHE_DISABLED:-false}"
export MEZZO_CACHE_GIF_TTL="${MEZZO_CACHE_GIF_TTL:-1h}"
export MEZZO_CACHE_GIF_MAX="${MEZZO_CACHE_GIF_MAX:-1000}"
export MEZZO_CACHE_SEARCH_TTL="${MEZZO_CACHE_SEARCH_TTL:-10m}"
export MEZZO_CACHE_SEARCH_MAX="${MEZZO_CACHE_SEARCH_MAX:-500}"
export MEZZO_CACHE_MEDIA_DIR="${MEZZO_CACHE_MEDIA_DIR:-}"
export MEZZO_CACHE_MEDIA_MAX_MB="${MEZZO_CACHE_MEDIA_MAX_MB:-512}"
export MEZZO_CACHE_MEDIA_MAX_FILE_MB="${MEZZO_CACHE_MEDIA_MAX_FILE_MB:-16}"
export MEZZO_CACHE_MEDIA_TTL="${MEZZO_CACHE_MEDIA_TTL:-168h}"
export MEZZO_CACHE_AVATAR_TTL="${MEZZO_CACHE_AVATAR_TTL:-24h}"

start_pre() {
	if [ -n "${MEZZO_CACHE_MEDIA_DIR}" ]; then
		checkpath --directory --owner "${command_user}" --mode 0700 "${MEZZO_CACHE_MEDIA_DIR}"
	fi
}

depend() {
	need net
}
